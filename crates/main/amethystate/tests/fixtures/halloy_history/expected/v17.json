{
  "halloy": {
    "font": {
      "family": "User Mono",
      "size": 19
    },
    "buffer": {
      "timestamp": {
        "format": "%H:%M:%S",
        "brackets": {
          "left": "[",
          "right": "]"
        }
      }
    },
    "servers": {
      "libera.net": {
        "nickname": "ignat",
        "server": "irc.libera.chat",
        "channels": [
          "#rust",
          "#halloy"
        ],
        "anti_flood": {
          "secs": 1,
          "nanos": 800000000
        }
      },
      "oftc": {
        "nickname": "second",
        "server": "irc.oftc.net",
        "channels": [],
        "anti_flood": {
          "secs": 3,
          "nanos": 500000000
        }
      }
    },
    "sidebar": {
      "max_width": 173,
      "unread_indicator": {
        "title": true,
        "icon": "star",
        "icon_size": 9,
        "highlight_icon": "speaker",
        "highlight_icon_size": 11
      },
      "position": "right",
      "show_user_menu": false,
      "order_by": "config",
      "scrollbar": {
        "width": 9,
        "scroller_width": 3
      },
      "server_icon_size": 17
    },
    "actions": {
      "sidebar": {
        "buffer": "replace-pane",
        "focused_buffer": "close-pane"
      }
    },
    "tooltips": false
  },
  "outside.note": "not ours"
}

