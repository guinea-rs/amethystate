{
  "scope": {
    "application": "Halloy",
    "first_release": "23.1-alpha1",
    "last_release": "2026.9",
    "as_of": "2026-10-19",
    "included": [
      "font.family and font.size (preservation probes)",
      "buffer.timestamp (preservation probe), including the new_buffer to buffer rename",
      "servers map: nickname, server, channels, anti_flood",
      "dashboard/sidebar action, width/max_width, buttons, unread/highlight indicators (except include/exclude), position, user menu, order_by, scrollbar, font sizes, server/primary icon",
      "actions.sidebar",
      "tooltips",
      "check_for_update_on_launch"
    ],
    "excluded": [
      "A port of selected configuration lines, not the entire Halloy codebase or every configuration option.",
      "Palette/theme rendering, IRC protocol types, inclusivity matching, and unrelated configuration are outside this fixture.",
      "YAML/TOML syntax changes are not migrations: this hypothetical application uses amethystate JSON from its first release.",
      "Schema numbers count changes in these selected lines; releases with the same selected schema still reopen and snapshot the same store."
    ],
    "workflow": "One store initialized once. Separate compiled applications expose only their own schema and earlier migrations. Every release opens, migrates, checks reactive handles, makes scripted user edits on first introduction of settings, saves, reopens, and snapshots. No version metadata or migration engine internals are written by the test."
  },
